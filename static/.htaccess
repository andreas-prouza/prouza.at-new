# Apache-Konfiguration für www.prouza.at (wird von Hugo unverändert nach public/ kopiert).
# Nur wirksam, wenn der Server .htaccess erlaubt (AllowOverride). Siehe docs/technik.md.

ErrorDocument 404 /de/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Startseite: Browser mit Englisch als erster Sprache → /en/ (wie auf der alten Seite);
  # alle anderen bekommen index.html, das auf /de/ weiterleitet. 302, weil die Antwort vom Browser abhängt.
  RewriteCond %{HTTP:Accept-Language} ^en [NC]
  RewriteRule ^$ /en/ [R=302,L]
</IfModule>

<IfModule mod_alias.c>
  # Alte URLs der vorigen Seite, die Hugo-aliases nicht abdecken (siehe docs/features/deployment.md).
  # Reihenfolge zählt: die erste passende Regel gewinnt.
  # SQL-Workshop ist Entwurf → Workshop-Übersicht
  RedirectMatch 301 ^/(de|en)/schulungen-sql/?$ /$1/workshops/
  RedirectMatch 301 ^/schulungen-sql/?$ /de/workshops/
  # RSS-Feeds
  RedirectMatch 301 ^/(de|en)/posts/index\.xml$ /$1/news/index.xml
  RedirectMatch 301 ^/(posts/)?index\.xml$ /de/news/index.xml
  # Seiten ohne Sprachpräfix → deutsche Fassung; dort leiten die aliases weiter
  RedirectMatch 301 ^/(about|contact|products|impress|schulungen(-[a-z]+)?|posts(/[a-z0-9-]+)?)/?$ /de/$1/
</IfModule>

<IfModule mod_headers.c>
  # Die Seite lädt nur eigene Bilder, Videos und das eigene Stylesheet; JavaScript gibt es keines.
  Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # CSS hat einen Fingerprint im Dateinamen und darf lange gecacht werden
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  # Videos haben einen Fingerprint im Dateinamen
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
